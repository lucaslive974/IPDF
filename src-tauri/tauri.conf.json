{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPDF Study Reader",
  "version": "0.1.0",
  "identifier": "com.ipdf.activestudyreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IPDF — Active Study Book Reader",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "Electronic Publication",
        "description": "EPUB Document",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": ["pdf"],
        "name": "Portable Document Format",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  }
}
