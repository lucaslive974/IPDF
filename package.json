{
  "name": "ipdf-active-study-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "biome format --write ./src",
    "lint": "biome check ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "verify:rust": "cargo fmt --manifest-path src-tauri/crates/ipdf-core/Cargo.toml --check && cargo clippy --manifest-path src-tauri/crates/ipdf-core/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/crates/ipdf-core/Cargo.toml",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run verify:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
